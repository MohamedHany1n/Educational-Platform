@using EducationalPlatform.Web.Models.Enums
@model EducationalPlatform.Web.Models.ViewModels.Admin.StudentDetailsViewModel
@{
    ViewData["Title"] = "الطالب: " + Model.FullName;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="mb-0">الطالب: @Model.FullName</h2>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Students" class="btn btn-outline-secondary">رجوع للقائمة</a>

        @if (Model.IsDeleted)
        {
            <form asp-action="RestoreStudent" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-success">استرجاع الطالب</button>
            </form>
        }
        else
        {
            <a asp-action="EditStudent" asp-route-id="@Model.Id" class="btn btn-primary">تعديل البيانات</a>

            @if (Model.StatusKey == "pending")
            {
                <a asp-action="PendingUsers" class="btn btn-warning">الموافقة من طلبات التسجيل</a>
            }
            else
            {
                <form asp-action="ToggleStudentStatus" asp-route-id="@Model.Id" method="post">
                    @if (Model.IsActive)
                    {
                        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('هل أنت متأكد من إيقاف حساب الطالب؟')">إيقاف الحساب</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-outline-success">تفعيل الحساب</button>
                    }
                </form>
            }

            <form asp-action="DeleteStudent" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger" onclick="return confirm('سيتم حذف الطالب وإخفاؤه من القوائم مع الاحتفاظ بسجلاته. متابعة؟')">حذف الطالب</button>
            </form>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-4"><strong>البريد الإلكتروني:</strong> @Model.Email</div>
            <div class="col-md-4"><strong>هاتف الطالب:</strong> <span dir="ltr">@(Model.PhoneNumber ?? "-")</span></div>
            <div class="col-md-4"><strong>هاتف ولي الأمر:</strong> <span dir="ltr">@(Model.ParentPhoneNumber ?? "-")</span></div>
            <div class="col-md-4"><strong>تاريخ التسجيل:</strong> @Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</div>
            <div class="col-md-4">
                <strong>الحالة:</strong>
                @switch (Model.StatusKey)
                {
                    case "active":
                        <span class="badge bg-success">نشط</span>
                        break;
                    case "pending":
                        <span class="badge bg-warning text-dark">بانتظار الموافقة</span>
                        break;
                    case "suspended":
                        <span class="badge bg-secondary">موقوف</span>
                        break;
                    default:
                        <span class="badge bg-danger">محذوف</span>
                        break;
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">أولياء الأمور (@Model.Parents.Count)</h5>
        @if (!Model.IsDeleted)
        {
            <a asp-action="CreateParent" asp-route-studentId="@Model.Id" class="btn btn-sm btn-outline-primary">حساب ولي أمر لهذا الطالب</a>
        }
    </div>
    <div class="card-body">
        @if (!Model.Parents.Any())
        {
            <p class="text-muted text-center my-3">لا يوجد ولي أمر مرتبط بهذا الطالب.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>الاسم</th>
                            <th>رقم الهاتف</th>
                            <th>تاريخ الربط</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var parent in Model.Parents)
                        {
                            <tr>
                                <td>@parent.FullName</td>
                                <td dir="ltr" style="text-align:right">@(parent.PhoneNumber ?? "-")</td>
                                <td>@parent.LinkedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                <td><a asp-action="ParentDetails" asp-route-id="@parent.Id" class="btn btn-sm btn-outline-primary">عرض</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header"><h5 class="mb-0">الكورسات المشترك فيها (@Model.Courses.Count)</h5></div>
    <div class="card-body">
        @if (!Model.Courses.Any())
        {
            <p class="text-muted text-center my-3">الطالب غير مشترك في أي كورس.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>الكورس</th>
                            <th>المدرس</th>
                            <th>تاريخ الاشتراك</th>
                            <th>الحصص المكتملة</th>
                            <th style="min-width:180px">التقدم</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model.Courses)
                        {
                            <tr>
                                <td>@course.CourseTitle</td>
                                <td>@course.TeacherName</td>
                                <td>@course.EnrolledAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                <td>@course.CompletedLessons من @course.TotalLessons</td>
                                <td>
                                    <div class="progress" role="progressbar" aria-valuenow="@course.Percent" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" style="width:@(course.Percent)%">@(course.Percent)%</div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header"><h5 class="mb-0">نتائج الامتحانات (@Model.Exams.Count)</h5></div>
    <div class="card-body">
        @if (!Model.Exams.Any())
        {
            <p class="text-muted text-center my-3">لم يدخل الطالب أي امتحان بعد.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>الامتحان</th>
                            <th>الكورس</th>
                            <th>الحالة</th>
                            <th>الدرجة</th>
                            <th>تاريخ البدء</th>
                            <th>تاريخ التسليم</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exam in Model.Exams)
                        {
                            <tr>
                                <td>@exam.ExamTitle</td>
                                <td>@exam.CourseTitle</td>
                                <td>
                                    @switch (exam.Status)
                                    {
                                        case AttemptStatus.InProgress:
                                            <span class="badge bg-info text-dark">جاري</span>
                                            break;
                                        case AttemptStatus.Submitted:
                                            <span class="badge bg-warning text-dark">بانتظار التصحيح</span>
                                            break;
                                        default:
                                            <span class="badge bg-success">تم التصحيح</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (exam.TotalScore.HasValue)
                                    {
                                        <span class="fw-bold">@exam.TotalScore.Value.ToString("0.##") / @exam.MaxScore.ToString("0.##")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@exam.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(exam.SubmittedAt.HasValue ? exam.SubmittedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header"><h5 class="mb-0">المدفوعات (@Model.Payments.Count)</h5></div>
    <div class="card-body">
        @if (!Model.Payments.Any())
        {
            <p class="text-muted text-center my-3">لا توجد طلبات دفع لهذا الطالب.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>الكورس</th>
                            <th>المبلغ</th>
                            <th>الوسيلة</th>
                            <th>رقم العملية</th>
                            <th>الحالة</th>
                            <th>التاريخ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model.Payments)
                        {
                            <tr>
                                <td>@payment.Id</td>
                                <td>@payment.CourseTitle</td>
                                <td class="fw-bold">@payment.Amount.ToString("N2") ج.م</td>
                                <td><span class="badge bg-secondary">@payment.PaymentMethod</span></td>
                                <td dir="ltr" style="text-align:right">@payment.TransactionNumber</td>
                                <td>
                                    @if (payment.Status == PaymentStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">قيد المراجعة</span>
                                    }
                                    else if (payment.Status == PaymentStatus.Approved)
                                    {
                                        <span class="badge bg-success">مقبول</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">مرفوض</span>
                                        @if (!string.IsNullOrEmpty(payment.RejectionReason))
                                        {
                                            <div class="small text-danger mt-1">السبب: @payment.RejectionReason</div>
                                        }
                                    }
                                </td>
                                <td>@payment.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
