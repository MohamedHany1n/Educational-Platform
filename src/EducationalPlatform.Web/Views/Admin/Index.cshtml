@model EducationalPlatform.Web.Models.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "لوحة تحكم الإدارة";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>لوحة تحكم الإدارة</h2>
    <div>
        <a asp-action="CreateTeacher" class="btn btn-primary me-2">+ إضافة مدرس جديد</a>
        <a asp-action="Payments" asp-route-status="Pending" class="btn btn-warning">
            مراجعة الإيصالات المعلقة (@Model.PendingPaymentsCount)
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-title">المدرسين</h6>
                <h2 class="mb-0">@Model.TotalTeachers</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-title">الطلاب المسجلين</h6>
                <h2 class="mb-0">@Model.TotalStudents</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-title">إجمالي الكورسات</h6>
                <h2 class="mb-0">@Model.TotalCourses</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-dark shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-title">الإيرادات المعتمدة</h6>
                <h2 class="mb-0">@Model.TotalApprovedRevenue.ToString("N2") ج.م</h2>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">أحدث إيصالات الدفع قيد المراجعة</h5>
        <a asp-action="Payments" class="btn btn-sm btn-outline-secondary">عرض الكل</a>
    </div>
    <div class="card-body">
        @if (!Model.RecentPendingPayments.Any())
        {
            <p class="text-muted text-center my-3">لا توجد إيصالات دفع معلقة حالياً.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>الطالب</th>
                            <th>الكورس</th>
                            <th>المبلغ</th>
                            <th>طريقة الدفع</th>
                            <th>تاريخ الطلب</th>
                            <th>إجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentPendingPayments)
                        {
                            <tr>
                                <td>@item.Student.FullName</td>
                                <td>@item.Course.Title</td>
                                <td>@item.Amount.ToString("N2") ج.م</td>
                                <td><span class="badge bg-secondary">@item.PaymentMethod</span></td>
                                <td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <a asp-action="Payments" asp-route-status="Pending" class="btn btn-sm btn-outline-primary">مراجعة</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
