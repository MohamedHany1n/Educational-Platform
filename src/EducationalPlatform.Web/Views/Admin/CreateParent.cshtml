@model EducationalPlatform.Web.Models.ViewModels.Admin.CreateParentViewModel
@{
    ViewData["Title"] = "إضافة ولي أمر";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">إنشاء حساب ولي أمر</h5>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(Model.StudentName))
                {
                    <div class="alert alert-info">
                        سيتم ربط الحساب تلقائياً بالطالب: <strong>@Model.StudentName</strong>
                    </div>
                }

                <form asp-action="CreateParent" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input asp-for="StudentId" type="hidden" />
                    <input asp-for="StudentName" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">الاسم بالكامل</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                        <input asp-for="Email" class="form-control" placeholder="parent@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label">رقم الهاتف</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="01012345678" inputmode="numeric" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">كلمة المرور المبدئية</label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Parents" class="btn btn-outline-secondary">رجوع للقائمة</a>
                        <button type="submit" class="btn btn-success">إنشاء الحساب</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
