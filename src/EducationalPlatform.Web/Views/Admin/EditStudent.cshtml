@model EducationalPlatform.Web.Models.ViewModels.Admin.EditStudentViewModel
@{
    ViewData["Title"] = "تعديل بيانات الطالب";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">تعديل بيانات الطالب</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="EditStudent" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input asp-for="Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">الاسم بالكامل</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                        <div class="form-text">تغيير البريد يغير بيانات دخول الطالب.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label">رقم هاتف الطالب</label>
                        <input asp-for="PhoneNumber" class="form-control" inputmode="numeric" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ParentPhoneNumber" class="form-label">رقم هاتف ولي الأمر</label>
                        <input asp-for="ParentPhoneNumber" class="form-control" inputmode="numeric" />
                        <span asp-validation-for="ParentPhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="StudentDetails" asp-route-id="@Model.Id" class="btn btn-outline-secondary">إلغاء</a>
                        <button type="submit" class="btn btn-success">حفظ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
