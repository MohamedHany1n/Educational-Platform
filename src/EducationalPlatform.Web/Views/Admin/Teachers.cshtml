@model List<EducationalPlatform.Web.Models.ViewModels.Admin.TeacherListItemViewModel>
@{
    ViewData["Title"] = "إدارة حسابات المدرسين";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>إدارة حسابات المدرسين</h2>
    <a asp-action="CreateTeacher" class="btn btn-primary">+ إضافة مدرس جديد</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted text-center my-4">لا يوجد مدرسين مسجلين حتى الآن.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>اسم المدرس</th>
                            <th>البريد الإلكتروني</th>
                            <th>رقم الهاتف</th>
                            <th>عدد الكورسات</th>
                            <th>الحالة</th>
                            <th>تاريخ الإنشاء</th>
                            <th>التحكم</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var teacher in Model)
                        {
                            <tr>
                                <td>@teacher.Id</td>
                                <td>@teacher.FullName</td>
                                <td>@teacher.Email</td>
                                <td>@(teacher.PhoneNumber ?? "-")</td>
                                <td>@teacher.CoursesCount</td>
                                <td>
                                    @if (teacher.IsActive)
                                    {
                                        <span class="badge bg-success">نشط</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">موقوف</span>
                                    }
                                </td>
                                <td>@teacher.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                <td>
                                    <form asp-action="ToggleTeacherStatus" asp-route-id="@teacher.Id" method="post" class="d-inline">
                                        @if (teacher.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('هل أنت متأكد من إيقاف حساب المدرس؟')">إيقاف الحساب</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success">تفعيل الحساب</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
