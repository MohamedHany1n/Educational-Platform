@model List<EducationalPlatform.Web.Services.NotificationViewModel>
@{
    ViewData["Title"] = "الإشعارات";
}

<h2 class="mb-4">الإشعارات</h2>

<div class="card shadow-sm">
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted text-center my-4">لا توجد إشعارات.</p>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var item in Model)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-bold">@item.Title</div>
                            <div>@item.Body</div>
                            <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd hh:mm tt")</small>
                        </div>
                        @if (!string.IsNullOrEmpty(item.Url))
                        {
                            <a href="@item.Url" class="btn btn-sm btn-outline-primary">عرض</a>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>
