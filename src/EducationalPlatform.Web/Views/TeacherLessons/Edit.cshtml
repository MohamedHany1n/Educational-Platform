@model EducationalPlatform.Web.Models.ViewModels.Teacher.LessonFormViewModel
@{ ViewData["Title"] = "تعديل الدرس"; }

<h2 class="mb-4">تعديل الدرس</h2>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <partial name="_LessonForm" model="Model" />
    <button type="submit" class="btn btn-primary">تحديث</button>
    <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-secondary">إلغاء</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
