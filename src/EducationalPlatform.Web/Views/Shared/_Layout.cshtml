<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EducationalPlatform.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EducationalPlatform.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">EducationalPlatform.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                                        </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-bold text-primary" asp-controller="Admin" asp-action="Index">لوحة الإدارة</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Admin" asp-action="Teachers">المدرسين</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Admin" asp-action="Students">الطلاب</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Admin" asp-action="Parents">أولياء الأمور</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Admin" asp-action="Payments">الإيصالات</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Admin" asp-action="PendingUsers">طلبات الحسابات</a>
                                </li>
                            }
                            @if (User.IsInRole("Teacher"))
                            {
                                     @if (User.IsInRole("Teacher"))
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link fw-bold text-success"
                                               asp-controller="Exams"
                                               asp-action="Create">
                                                إنشاء امتحان
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link fw-bold text-primary"
                                               asp-controller="Exams"
                                               asp-action="MyExams">
                                                الامتحانات
                                            </a>
                                        </li>
                                    }
                                    <li class="nav-item">
                                        <a class="nav-link fw-bold text-info"
                                           asp-controller="Exams"
                                           asp-action="PendingGrading">
                                            قيد المراجعة
                                        </a>
                                    </li>
                            }

                            @if (User.IsInRole("Student"))
                            {
                              <li class="nav-item">
                                <a class="nav-link fw-bold text-primary"  asp-controller="StudentExams" asp-action="Available"> الامتحانات </a> </li>
                                <li class="nav-item">
                                        <a class="nav-link fw-bold text-danger" asp-controller="StudentExams" asp-action="History">
                                            درجاتي
                                        </a>
                                    </li>
                             }
                            <li class="nav-item">
                                <span class="nav-link text-dark">مرحباً، @User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Profile" asp-action="ChangePassword">تغيير كلمة المرور</a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link text-danger">تسجيل خروج</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">دخول</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">حساب جديد</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EducationalPlatform.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


