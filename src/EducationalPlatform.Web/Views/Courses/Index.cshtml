@model List<EducationalPlatform.Web.Models.ViewModels.Student.CourseCardViewModel>
@{
    ViewData["Title"] = "الكورسات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>الكورسات المتاحة</h2>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-6">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="ابحث باسم الكورس..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">بحث</button>
        <a asp-action="Index" class="btn btn-outline-secondary">الكل</a>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted text-center my-4">لا توجد كورسات مطابقة.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var course in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@course.Title</h5>
                        <p class="card-text text-muted small">@course.TeacherName</p>
                        <p class="card-text flex-grow-1">@course.Description</p>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold">@course.Price.ToString("N2") ج.م</span>
                            <span class="badge bg-secondary">@course.LessonsCount درس</span>
                        </div>
                        @if (course.IsEnrolled)
                        {
                            <a asp-action="Watch" asp-route-id="@course.Id" class="btn btn-success w-100">مشترك - ابدأ المشاهدة</a>
                        }
                        else if (course.HasPendingRequest)
                        {
                            <a asp-controller="Payments" asp-action="Mine" class="btn btn-outline-warning w-100">طلب الدفع قيد المراجعة</a>
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-primary w-100">التفاصيل والاشتراك</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
