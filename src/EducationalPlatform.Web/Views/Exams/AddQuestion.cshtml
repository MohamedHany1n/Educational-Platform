@model EducationalPlatform.Web.ViewModels.AddQuestionViewModel
@using EducationalPlatform.Web.Models.Enums

@{
    ViewData["Title"] = "إضافة سؤال";
}

<div class="container mt-4" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">إضافة سؤال للامتحان</h4>
                </div>

                <p class="mb-0 mt-2">
                     السؤال رقم <strong>@Model.QuestionNumber</strong>
                </p>

                <div class="card-body">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <form asp-action="AddQuestion" method="post">

                        <input type="hidden" asp-for="ExamId" />

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Text" class="form-label">
                                نص السؤال
                            </label>

                            <textarea asp-for="Text"
                                      class="form-control"
                                      rows="3"></textarea>

                            <span asp-validation-for="Text"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Type" class="form-label">
                                نوع السؤال
                            </label>

                            <select asp-for="Type"
                                    class="form-select"
                                    id="questionType">
                                <option value="MCQ">اختيار من متعدد</option>
                                <option value="Essay">مقالي</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Marks" class="form-label">
                                درجة السؤال
                            </label>

                            <input asp-for="Marks"
                                   type="number"
                                   step="0.5"
                                   min="0.5"
                                   class="form-control" />

                            <span asp-validation-for="Marks"
                                  class="text-danger"></span>
                        </div>

                        <div id="mcqSection">

                            <hr />

                            <h5>الاختيارات</h5>

                            <div id="optionsContainer">

                                @for (int i = 0; i < Model.Options.Count; i++)
                                {
                                    <div class="input-group mb-2 option-item">

                                        <div class="input-group-text">
                                            <input type="checkbox"
                                                   name="CorrectOptionIndexes"
                                                   value="@i"
                                                   class="form-check-input"
                                            @(Model.CorrectOptionIndexes.Contains(i) ? "checked" : "") />
                                        </div>

                                        <input name="Options[@i]"
                                               value="@Model.Options[i]"
                                               class="form-control"
                                               placeholder="الاختيار @(i + 1)" />

                                        <button type="button"
                                                class="btn btn-outline-danger remove-option">
                                            حذف
                                        </button>

                                    </div>
                                }

                            </div>

                            <button type="button"
                                    id="addOption"
                                    class="btn btn-outline-primary btn-sm">
                                + إضافة اختيار
                            </button>

                            <span asp-validation-for="Options"
                                  class="text-danger d-block"></span>

                            <span asp-validation-for="CorrectOptionIndexes"
                                  class="text-danger d-block"></span>

                        </div>

                        <hr />

                        <button type="submit"
                                class="btn btn-success w-100">
                            حفظ السؤال
                        </button>

                        <a asp-controller="Exams"
                           asp-action="MyExams"
                           class="btn btn-outline-secondary w-100 mt-2">
                            Finish Adding Questions
                        </a>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
       const questionType = document.getElementById("questionType");
const mcqSection = document.getElementById("mcqSection");
const optionsContainer = document.getElementById("optionsContainer");
const addOptionButton = document.getElementById("addOption");

function updateQuestionType() {
    mcqSection.style.display =
        questionType.value === "MCQ" ? "block" : "none";
}

function updateRemoveButtons() {
    const items = optionsContainer.querySelectorAll(".option-item");

    items.forEach(item => {
        const button = item.querySelector(".remove-option");
        button.disabled = items.length <= 2;
    });
}

function reindexOptions() {
    const items = optionsContainer.querySelectorAll(".option-item");

    items.forEach((item, index) => {
        const input = item.querySelector('input:not([type="checkbox"])');
        const checkbox = item.querySelector('input[type="checkbox"]');

        input.name = `Options[${index}]`;
        input.placeholder = `الاختيار ${index + 1}`;
        checkbox.value = index;
    });

    updateRemoveButtons();
}

questionType.addEventListener("change", updateQuestionType);

updateQuestionType();
updateRemoveButtons();

addOptionButton.addEventListener("click", function () {
    const index = optionsContainer.querySelectorAll(".option-item").length;

    const item = document.createElement("div");
    item.className = "input-group mb-2 option-item";

    item.innerHTML = `
        <div class="input-group-text">
            <input type="checkbox"
                   name="CorrectOptionIndexes"
                   value="${index}"
                   class="form-check-input" />
        </div>

        <input name="Options[${index}]"
               class="form-control"
               placeholder="الاختيار ${index + 1}" />

        <button type="button"
                class="btn btn-outline-danger remove-option">
            حذف
        </button>
    `;

    optionsContainer.appendChild(item);
    updateRemoveButtons();
});

optionsContainer.addEventListener("click", function (event) {
    if (event.target.classList.contains("remove-option")) {
        if (optionsContainer.querySelectorAll(".option-item").length > 2) {
            event.target.closest(".option-item").remove();
            reindexOptions();
        }
    }
});
    </script>
}
