@model List<EducationalPlatform.Web.Models.ViewModels.Exam.PendingGradingViewModel>

@{
    ViewData["Title"] = "Pending Grading";
}

<div class="container mt-4">
    <h2 class="mb-4">Pending Exam Grading</h2>
          @if (TempData["SuccessMessage"] != null)
        {
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
        }
    @if (!Model.Any())
    {
        <div class="alert alert-success">
            No exam attempts are waiting for grading.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Student</th>
                        <th>Exam</th>
                        <th>Course</th>
                        <th>Attempt</th>
                        <th>Submitted At</th>
                        <th>Pending Essays</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var attempt in Model)
                    {
                        <tr>
                            <td>@attempt.StudentName</td>
                            <td>@attempt.ExamTitle</td>
                            <td>@attempt.CourseTitle</td>
                            <td>#@attempt.AttemptNumber</td>
                            <td>@attempt.SubmittedAt.ToLocalTime().ToString("g")</td>
                            <td>
                                <span class="badge bg-warning text-dark">
                                    @attempt.PendingEssaysCount
                                </span>
                            </td>
                            <td>
                                <a asp-action="GradeAttempt"
                                   asp-route-id="@attempt.AttemptId"
                                   class="btn btn-sm btn-primary">
                                    Grade
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>