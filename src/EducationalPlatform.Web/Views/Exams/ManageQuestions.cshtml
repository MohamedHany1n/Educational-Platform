@model List<EducationalPlatform.Web.ViewModels.ManageQuestionViewModel>
@using EducationalPlatform.Web.Models.Enums

@{
    ViewData["Title"] = "إدارة الأسئلة";
}

<div class="container mt-4" dir="rtl">
    @if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-center">
        @TempData["ErrorMessage"]
    </div>
}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>إدارة الأسئلة</h2>
            <p class="text-muted mb-0">@ViewBag.ExamTitle</p>
        </div>

        @if (ViewBag.CanManageQuestions)
         {
          <a asp-action="AddQuestion"
       asp-route-examId="@ViewBag.ExamId"
       class="btn btn-primary">
        + إضافة سؤال
                </a>
               }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            لا توجد أسئلة في هذا الامتحان حتى الآن.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover text-center align-middle">

                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>السؤال</th>
                        <th>النوع</th>
                        <th>الدرجة</th>
                        <th>عدد الاختيارات</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var question = Model[i];

                        <tr>
                            <td>@(i + 1)</td>
                            <td class="table-content text-start">
                                @question.Text
                            </td>
                            <td>
                                @(question.Type == QuestionType.MCQ
                                    ? "اختيار من متعدد"
                                    : "مقالي")
                            </td>
                            <td>@question.Marks</td>
                            <td>@question.OptionsCount</td>

                            <td>
    @if (ViewBag.CanManageQuestions)
    {
        <div class="action-buttons">

            <a asp-action="EditQuestion"
               asp-route-id="@question.Id"
               class="btn btn-sm btn-warning">
                تعديل
            </a>

            <form asp-action="DeleteQuestion"
                  asp-route-id="@question.Id"
                  method="post"
                  onsubmit="return confirm('هل أنت متأكد من حذف هذا السؤال؟');">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-sm btn-danger">
                    حذف
                </button>
            </form>

        </div>
    }
    else
    {
        <span class="text-muted">غير متاح بعد بدء الامتحان</span>
    }
</td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    <a asp-action="MyExams"
       class="btn btn-outline-secondary mt-3">
        العودة إلى امتحاناتي
    </a>

</div>
