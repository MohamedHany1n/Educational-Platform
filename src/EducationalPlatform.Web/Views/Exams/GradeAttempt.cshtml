@model EducationalPlatform.Web.Models.ViewModels.Exam.GradeAttemptViewModel


@{
    ViewData["Title"] = "Grade Attempt";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Grade Exam Attempt</h2>

        <a asp-action="PendingGrading"
           class="btn btn-outline-secondary">
            Back to Pending Grading
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h4>@Model.ExamTitle</h4>
            <p><strong>Student:</strong> @Model.StudentName</p>
            <p class="mb-0">
                <strong>Attempt:</strong> #@Model.AttemptNumber
            </p>
        </div>
    </div>

    <form asp-action="GradeAttempt"
          asp-route-id="@Model.AttemptId"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" name="AttemptId" value="@Model.AttemptId" />

        @for (int i = 0; i < Model.Answers.Count; i++)
        {
            var answer = Model.Answers[i];

            <div class="card mb-4">
                <div class="card-body">
                    <h5>Question @(i + 1)</h5>

                    <p>@answer.QuestionText</p>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Student Answer
                        </label>

                        <div class="border rounded p-3 bg-light"
                             style="white-space: pre-wrap;">
                            @(answer.EssayText ?? "No answer provided.")
                        </div>
                    </div>

                    <input type="hidden"
                           name="Answers[@i].AnswerId"
                           value="@answer.AnswerId" />

                    <div class="mb-3">
                        <label class="form-label">
                            Score (Maximum: @answer.Marks)
                        </label>

                        <input type="number"
                               name="Answers[@i].Score"
                               class="form-control"
                               min="0"
                               max="@answer.Marks"
                               step="0.5"
                               value="@answer.Score"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Teacher Feedback
                        </label>

                        <textarea name="Answers[@i].TeacherFeedback"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500">@answer.TeacherFeedback</textarea>
                    </div>
                </div>
            </div>
        }

        <button type="submit" class="btn btn-success">
            Save Grading
        </button>
    </form>
</div>