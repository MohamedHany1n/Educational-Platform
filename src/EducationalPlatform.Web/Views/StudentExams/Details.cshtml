@model EducationalPlatform.Web.ViewModels.ExamDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل الامتحان";
}

<div class="container mt-5" dir="rtl">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
    <div class="card shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-body p-4">

            <h2 class="text-center mb-4">@Model.Title</h2>

            <p>
                <strong>الكورس:</strong>
                @Model.CourseTitle
            </p>

            <hr />

            <div class="row text-center g-3">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded">
                        <h5>مدة الامتحان</h5>
                        <p class="mb-0">@Model.DurationMinutes دقيقة</p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded">
                        <h5>عدد الأسئلة</h5>
                        <p class="mb-0">@Model.QuestionsCount</p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded">
                        <h5>الدرجة النهائية</h5>
                        <p class="mb-0">@Model.TotalMarks</p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded">
                        <h5>المحاولات</h5>
                        <p class="mb-0">
                            @Model.AttemptsUsed / @Model.MaxAttempts
                        </p>
                    </div>
                </div>
            </div>

            <hr />

            <div class="text-center mt-4">
                @if (Model.RemainingAttempts > 0)
                {
                        <form asp-action="Start" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-lg">
                                ابدأ الامتحان
                            </button>
                        </form>
                }
                else
                {
                    <button class="btn btn-secondary btn-lg" disabled>
                        استنفدت جميع المحاولات
                    </button>
                }

                <div class="mt-3">
                    <a asp-action="Available"
                       class="btn btn-outline-secondary">
                        العودة للامتحانات
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
