@model List<EducationalPlatform.Web.Models.ViewModels.Exam.AvailableExamViewModel>

@{
    ViewData["Title"] = "الامتحانات المتاحة";
}

<div class="container mt-4" dir="rtl">

    <h2 class="mb-4">الامتحانات المتاحة</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            لا توجد امتحانات متاحة حاليًا.
        </div>
    }
    else
    {
        <div class="row g-3">

            @foreach (var exam in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h5 class="card-title">
                                @exam.Title
                            </h5>

                            <p class="text-muted mb-2">
                                الكورس: @exam.CourseTitle
                            </p>

                            <p>
                                <strong>مدة الامتحان:</strong>
                                @exam.DurationMinutes دقيقة
                            </p>

                            <p>
                                <strong>عدد المحاولات:</strong>
                                @exam.AttemptsUsed / @exam.MaxAttempts
                            </p>

                            @if (exam.AttemptsUsed < exam.MaxAttempts)
                            {
                                <a asp-action="Details"
                                   asp-route-id="@exam.Id"
                                   class="btn btn-primary">
                                    تفاصيل الامتحان
                                </a>
                                    }
                            else
                            {
                                <button class="btn btn-secondary w-100" disabled>
                                    استنفدت المحاولات
                                </button>
                            }

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>