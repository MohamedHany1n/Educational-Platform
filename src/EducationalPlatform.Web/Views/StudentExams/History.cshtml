@model List<EducationalPlatform.Web.ViewModels.StudentAttemptHistoryViewModel>

@{
    ViewData["Title"] = "My Attempts";
}

<div class="container mt-4">
    <h2 class="mb-4">My Exam Attempts</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You haven't taken any exams yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Exam</th>
                        <th>Course</th>
                        <th>Attempt</th>
                        <th>Started At</th>
                        <th>Submitted At</th>
                        <th>Status</th>
                        <th>Score</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attempt in Model)
                    {
                        <tr>
                            <td>@attempt.ExamTitle</td>
                            <td>@attempt.CourseTitle</td>
                            <td>#@attempt.AttemptNumber</td>
                            <td>@attempt.StartedAt.ToLocalTime().ToString("g")</td>
                            <td>
                                @(attempt.SubmittedAt?.ToLocalTime().ToString("g") ?? "-")
                            </td>
                            <td>
                                @if (attempt.Status == "Graded")
                                {
                                    <span class="badge bg-success">Graded</span>
                                }
                                else if (attempt.Status == "Submitted")
                                {
                                    <span class="badge bg-warning text-dark">Awaiting Grading</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">@attempt.Status</span>
                                }
                            </td>
                            <td>
                                @(attempt.TotalScore?.ToString("0.##") ?? "Pending")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>